<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Turian</RootNamespace>
        <PackageId>MASS4.Turian.Engine.Attributes</PackageId>
        <!-- Release packaging includes the shared MASS4.Attributes assembly from this output. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' != ''">
        <ProjectReference Include="$(GuinevereLocalPath)/Attributes/Attributes.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' == ''">
        <PackageReference Include="MASS4.Attributes" Version="6.*" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="MASS4.Attributes" />
    </ItemGroup>
</Project>
