<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>MASS4.Turian.Engine.UI</PackageId>
    </PropertyGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' != ''">
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere/Guinevere.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' == ''">
        <PackageReference Include="MASS4.Guinevere" Version="5.*"/>
    </ItemGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Turian/Engine/Core/Turian.Engine.Core.csproj"/>
    </ItemGroup>

</Project>
