<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.1.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>OpenAssetPackage</RootNamespace>
        <PackageId>MASS4.OpenAssetPackage</PackageId>
        <Description>Reader and writer for Open Asset Package (.oap) 1.1, a random-access, streamable asset container.</Description>
        <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
        <PackageTags>oap;asset;package;container;gamedev</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Turian.Tests"/>
    </ItemGroup>

    <!-- Engine-independent: no Turian or Gaya references. -->
    <ItemGroup>
        <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
        <!-- Managed Zstandard until the BCL's ZstandardStream (.NET 11) is available to net10.0 consumers. -->
        <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    </ItemGroup>
</Project>
