<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.3.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Turian.Engine.Core</RootNamespace>
        <PackageId>MASS4.Turian.Engine</PackageId>
        <Description>The Turian engine runtime API that game code and bricks compile against, with its component source generator.</Description>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackCodeGenerator</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Turian.Tests"/>
        <InternalsVisibleTo Include="Turian.Benchmarks"/>
        <InternalsVisibleTo Include="Turian.Engine.Vulkan"/>
    </ItemGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Turian/Engine/Attributes/Turian.Engine.Attributes.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/CSharp/CodeGenerator/Turian.CSharp.CodeGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Consumers of the package run the same component generator as this project. -->
    <Target Name="PackCodeGenerator">
        <MSBuild Projects="$(SolutionDir)/Turian/Editor/CSharp/CodeGenerator/Turian.CSharp.CodeGenerator.csproj"
                 Targets="GetTargetPath" RemoveProperties="TargetFramework;RuntimeIdentifier">
            <Output TaskParameter="TargetOutputs" ItemName="CodeGeneratorAssembly"/>
        </MSBuild>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(CodeGeneratorAssembly)" PackagePath="analyzers/dotnet/cs"/>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Gaya/MASS4.Bricks/MASS4.Bricks.csproj" />
    </ItemGroup>

    <!-- Engine-independent libraries, each in its own repository; the local checkout is used while unpublished. -->
    <ItemGroup>
        <ProjectReference Include="$(OapLocalPath)/csharp/OpenAssetPackage.csproj" Condition="'$(OapLocalPath)' != ''"/>
        <ProjectReference Include="$(Ktx2LocalPath)/Ktx2/Ktx2.csproj" Condition="'$(Ktx2LocalPath)' != ''"/>
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <!-- Key/MouseButton/Gamepad enums of the input contract; managed only, no window or native backend. -->
        <PackageReference Include="Silk.NET.Input.Common" Version="2.23.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.13" />
        <PackageReference Include="MASS4.Ktx2" Version="1.*" Condition="'$(Ktx2LocalPath)' == ''"/>
        <PackageReference Include="MASS4.OpenAssetPackage" Version="1.*" Condition="'$(OapLocalPath)' == ''"/>
    </ItemGroup>
</Project>
