<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>5.3.0</Version>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>MASS4.Turian.Testing</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Headless component testing with controlled frames and input.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <ProjectReference Include="../Engine/Core/Turian.Engine.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>
</Project>
