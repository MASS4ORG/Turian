<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>MASS4.Localization</PackageId>
        <Version>0.1.0</Version>
        <Description>Shared string tables, localization and translation interchange.</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../LocalizationAbstractions/MASS4.Localization.Abstractions.csproj" />
        <ProjectReference Include="$(GuinevereLocalPath)/Attributes/Attributes.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
        <PackageReference Include="MASS4.Attributes" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="MASS4.Attributes" />
        <Using Include="System.Globalization" />
        <Using Include="System.Text" />
        <Using Include="System.Text.Json" />
        <Using Include="System.Text.Json.Serialization" />
        <Using Include="System.Xml.Linq" />
    </ItemGroup>
</Project>
