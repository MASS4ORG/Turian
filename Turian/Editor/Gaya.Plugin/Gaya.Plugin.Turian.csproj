<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.1.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>Gaya.Plugin.Turian</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization/*.strings"/>
        <EmbeddedResource Include="Resources/logo.png"/>
    </ItemGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Sdk/Gaya.Sdk.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Packages.Editor/Gaya.Packages.Editor.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/Core/Turian.Editor.Core.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/CSharp/CodeGenerator/Turian.CSharp.CodeGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- Feeds the About panel's BuildInfo: the version string is this project's Version, CONTRIBUTORS.md is
         parsed at compile time by BuildInfoGenerator. -->
    <ItemGroup>
        <AdditionalFiles Include="$(SolutionDir)/docs/CONTRIBUTORS.md"/>
        <CompilerVisibleProperty Include="Version"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Excalibur/Guinevere.Excalibur.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
        <ProjectReference Include="$(GuinevereLocalPath)/Autoformers.Excalibur/Autoformers.Excalibur.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MASS4.Guinevere.Excalibur" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
        <PackageReference Include="MASS4.Autoformers.Excalibur" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12"/>
    </ItemGroup>

</Project>
