<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseFileScopedNamespaces>true</UseFileScopedNamespaces>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>Gaya.Plugin.Turian</PackageId>
    </PropertyGroup>

    <PropertyGroup>
        <SolutionDir Condition="'$(SolutionDir)' == ''">../../..</SolutionDir>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization/*.strings"/>
        <EmbeddedResource Include="Resources/logo.png"/>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Sdk/Gaya.Sdk.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/Core/Turian.Editor.Core.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/CSharp/CodeGenerator/Turian.CSharp.CodeGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- Feeds the About panel's BuildInfo: the version string comes from git, CONTRIBUTORS.md is
         parsed at compile time by BuildInfoGenerator. -->
    <ItemGroup>
        <AdditionalFiles Include="$(SolutionDir)/docs/CONTRIBUTORS.md"/>
        <CompilerVisibleProperty Include="GitDescribe"/>
    </ItemGroup>

    <Target Name="ResolveGitDescribe" BeforeTargets="CoreCompile;GenerateMSBuildEditorConfigFileShouldRun">
        <Exec Command="git describe --tags --always --dirty" ConsoleToMSBuild="true" IgnoreExitCode="true"
              StandardOutputImportance="low" WorkingDirectory="$(SolutionDir)">
            <Output TaskParameter="ConsoleOutput" ItemName="_GitDescribeLines"/>
            <Output TaskParameter="ExitCode" PropertyName="_GitDescribeExitCode"/>
        </Exec>
        <PropertyGroup>
            <GitDescribe Condition="'$(_GitDescribeExitCode)' == '0' And '@(_GitDescribeLines)' != ''">@(_GitDescribeLines)</GitDescribe>
            <GitDescribe Condition="'$(GitDescribe)' == ''">dev</GitDescribe>
        </PropertyGroup>
    </Target>

    <!-- Guinevere window. Local checkout in dev; falls back to the published package. -->
    <ItemGroup Condition="'$(GuinevereLocalPath)' != ''">
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Excalibur/Guinevere.Excalibur.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12"/>
        <PackageReference Include="MASS4.Guinevere.Excalibur" Version="4.1.0" ExcludeAssets="$(GuineverePackageExcludeAssets)" />
    </ItemGroup>

</Project>
