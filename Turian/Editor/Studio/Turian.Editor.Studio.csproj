<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.4.1</Version>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Turian.Editor.Studio</RootNamespace>
        <AssemblyName>Turian.Editor.Studio</AssemblyName>
        <ApplicationIcon>$(SolutionDir)/Gaya/Gaya.Host/Resources/logo.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Host/Gaya.Host.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/Gaya.Plugin/Gaya.Plugin.Turian.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere/Guinevere.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Excalibur/Guinevere.Excalibur.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Scripting/Guinevere.Scripting.csproj" Condition="'$(GuinevereLocalPath)' != ''"/>
        <ProjectReference Include="$(GuinevereLocalPath)/Integrations/Guinevere.Vulkan.SilkNET/Guinevere.Vulkan.SilkNET.csproj" Condition="'$(GuinevereLocalPath)' != ''"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MASS4.Guinevere" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
        <PackageReference Include="MASS4.Guinevere.Excalibur" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
        <PackageReference Include="MASS4.Guinevere.Scripting" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
        <PackageReference Include="MASS4.Guinevere.Vulkan.SilkNET" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
        <PackageReference Include="SkiaSharp" Version="4.153.1" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="$(SolutionDir)/Turian/Editor/CLI/Platform/**/*"
                 Exclude="$(SolutionDir)/Turian/Editor/CLI/Platform/**/bin/**;$(SolutionDir)/Turian/Editor/CLI/Platform/**/obj/**"
                 LinkBase="Platform"
                 CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <Import Project="$(SolutionDir)/Turian/Packages/Bricks.targets"/>

</Project>
