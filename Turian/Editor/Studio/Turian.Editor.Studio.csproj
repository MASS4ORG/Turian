<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Turian.Editor.Studio</RootNamespace>
        <AssemblyName>Turian.Editor.Studio</AssemblyName>
        <ApplicationIcon>$(SolutionDir)/Gaya/Gaya.Host/Resources/logo.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Host/Gaya.Host.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Packages/org.mass4.turian.hzb/Source~/Turian.Engine.Hzb/Turian.Engine.Hzb.csproj"
                          ReferenceOutputAssembly="false" Private="false"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/Gaya.Plugin/Gaya.Plugin.Turian.csproj"/>
        <!-- Built for their Precast~ output (the UI brick's prebuilt assemblies), not referenced by the host. -->
        <ProjectReference Include="$(SolutionDir)/Turian/Packages/org.mass4.turian.ui/Source~/Turian.Engine.UI/Turian.Engine.UI.csproj"
                          ReferenceOutputAssembly="false" Private="false"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Packages/org.mass4.turian.ui/Source~/Turian.Editor.UI/Turian.Editor.UI.csproj"
                          ReferenceOutputAssembly="false" Private="false"/>
    </ItemGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' != ''">
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere/Guinevere.csproj"/>
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Excalibur/Guinevere.Excalibur.csproj"/>
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Scripting/Guinevere.Scripting.csproj"/>
        <ProjectReference Include="$(GuinevereLocalPath)/Integrations/Guinevere.Vulkan.SilkNET/Guinevere.Vulkan.SilkNET.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' == ''">
        <PackageReference Include="MASS4.Guinevere" Version="6.*"/>
        <PackageReference Include="MASS4.Guinevere.Excalibur" Version="6.*"/>
        <PackageReference Include="MASS4.Guinevere.Scripting" Version="6.*"/>
        <PackageReference Include="MASS4.Guinevere.Vulkan.SilkNET" Version="6.*"/>
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12"/>
        <PackageReference Include="SkiaSharp" Version="4.153.1" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="$(SolutionDir)/Turian/Editor/CLI/Platform/**/*"
                 Exclude="$(SolutionDir)/Turian/Editor/CLI/Platform/**/bin/**;$(SolutionDir)/Turian/Editor/CLI/Platform/**/obj/**"
                 LinkBase="Platform"
                 CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <Import Project="$(SolutionDir)/Turian/Packages/Bricks.targets"/>

</Project>
