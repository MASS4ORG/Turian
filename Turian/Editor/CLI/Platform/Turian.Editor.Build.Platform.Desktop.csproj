<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <ExcludeFromBuild>true</ExcludeFromBuild>
        <!-- Referenced transitively by Editor.Core; without these, publishing any Exe that pulls
             this project in (any RID) fails with NETSDK1152 (duplicate apphost/runtimeconfig). -->
        <UseAppHost>false</UseAppHost>
        <IsPublishable>false</IsPublishable>
    </PropertyGroup>

    <!-- Internal paths: resolved from this project, which Play mode copies next to the generated executable. -->
    <PropertyGroup>
        <TurianDir>$(MSBuildThisFileDirectory)../../../..</TurianDir>
    </PropertyGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(TurianDir)/Turian/Engine/Attributes/Turian.Engine.Attributes.csproj"/>
        <ProjectReference Include="$(TurianDir)/Turian/Engine/Core/Turian.Engine.Core.csproj"/>
        <ProjectReference Include="$(TurianDir)/Gaya/Gaya.Attributes/Gaya.Attributes.csproj"/>
    </ItemGroup>

    <!-- External libraries. The renderer and window come from the game's render brick, never from the launcher. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    </ItemGroup>

    <Import Project="../../Core/Build/Settings/RuntimeDependencies.targets"/>
</Project>
