<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.3.0</Version>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    </PropertyGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <InternalsVisibleTo Include="Turian.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Turian/Engine/Core/Turian.Engine.Core.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Packages/org.mass4.turian.vulkan/Source~/Turian.Engine.Vulkan/Turian.Engine.Vulkan.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/Core/Turian.Editor.Core.csproj"/>
        <!-- Theme verification compiles sheets with the host's theme catalog. -->
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Host/Gaya.Host.csproj"/>
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
        <PackageReference Include="SkiaSharp" Version="4.153.1" />
    </ItemGroup>

    <!-- The platform host template is copied, not compiled -->
    <ItemGroup>
        <Compile Remove="Platform/**/*"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Platform/**/*" Exclude="Platform/**/bin/**;Platform/**/obj/**"
                 CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <Import Project="$(SolutionDir)/Turian/Packages/Bricks.targets"/>

</Project>
