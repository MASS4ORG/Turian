<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    </PropertyGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <InternalsVisibleTo Include="Turian.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Turian/Engine/Core/Turian.Engine.Core.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Packages/org.mass4.turian.hzb/Source~/Turian.Engine.Hzb/Turian.Engine.Hzb.csproj"
                          ReferenceOutputAssembly="false" Private="false"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/Core/Turian.Editor.Core.csproj"/>
        <!-- Built for their Precast~ output (the UI brick's prebuilt assemblies), not referenced by the host. -->
        <ProjectReference Include="$(SolutionDir)/Turian/Packages/org.mass4.turian.ui/Source~/Turian.Engine.UI/Turian.Engine.UI.csproj"
                          ReferenceOutputAssembly="false" Private="false"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Packages/org.mass4.turian.ui/Source~/Turian.Editor.UI/Turian.Editor.UI.csproj"
                          ReferenceOutputAssembly="false" Private="false"/>
    </ItemGroup>

    <!-- Headless UI renders through the in-game UI brick, whose prebuilt assemblies run on the host's Guinevere and Skia. -->
    <ItemGroup Condition="'$(GuinevereLocalPath)' != ''">
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere/Guinevere.csproj"/>
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Styling/Guinevere.Styling.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' == ''">
        <PackageReference Include="MASS4.Guinevere" Version="6.*"/>
        <PackageReference Include="MASS4.Guinevere.Styling" Version="6.*"/>
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
        <PackageReference Include="SkiaSharp" Version="4.153.1" />
    </ItemGroup>

    <!-- The platform host template is copied, not compiled -->
    <ItemGroup>
        <Compile Remove="Platform/**/*"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Platform/**/*" Exclude="Platform/**/bin/**;Platform/**/obj/**"
                 CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <Import Project="$(SolutionDir)/Turian/Packages/Bricks.targets"/>

</Project>
