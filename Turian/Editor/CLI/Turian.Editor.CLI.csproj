<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    </PropertyGroup>

    <!-- Exclude a folder from compilation -->
    <ItemGroup>
        <Compile Remove="Platform\**\*"/>
    </ItemGroup>

    <!-- Include a folder as an asset -->
    <ItemGroup>
        <Content Include="Platform\**\*" Exclude="Platform\**\bin\**;Platform\**\obj\**"
                 CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
        <PackageReference Include="SkiaSharp" Version="4.152.1" />
    </ItemGroup>

    <!-- Internal libraries -->
    <PropertyGroup>
        <SolutionDir Condition="'$(SolutionDir)' == ''">../../..</SolutionDir>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Turian/Engine/Core/Turian.Engine.Core.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Engine/UI/Turian.Engine.UI.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Editor/Core/Turian.Editor.Core.csproj"/>
    </ItemGroup>
  <!-- Excalibur controls. A gitignored .csproj.user points GuinevereLocalPath at a local checkout;
       CI has none and restores the package instead. Uncomment the package once it is published. -->
  <ItemGroup Condition="'$(GuinevereLocalPath)' != ''">
    <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Excalibur/Guinevere.Excalibur.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- <PackageReference Include="MASS4.Guinevere.Excalibur" Version="2.0.1" ExcludeAssets="$(GuineverePackageExcludeAssets)" /> -->
  </ItemGroup>

</Project>
