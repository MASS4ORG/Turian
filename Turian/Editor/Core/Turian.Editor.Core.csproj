<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.3.2</Version>
        <TargetFramework>net10.0</TargetFramework>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <NoWarn>$(NoWarn);NU1701</NoWarn>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Turian.Editor.Core</RootNamespace>
        <!-- The Assimp bindings are pointer-based. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Turian/Engine/Core/Turian.Engine.Core.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Packages/org.mass4.turian.vulkan/Source~/Turian.Engine.Vulkan/Turian.Engine.Vulkan.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Gaya/MASS4.Bricks/MASS4.Bricks.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Attributes/Gaya.Attributes.csproj"/>
        <ProjectReference Include="../CLI/Platform/Turian.Editor.Build.Platform.Desktop.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(GuinevereLocalPath)/Autoformers/Autoformers.csproj" Condition="'$(GuinevereLocalPath)' != ''"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MASS4.Autoformers" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''"/>
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <PackageReference Include="Codeuctivity.SanitizeFilename" Version="3.0.230"/>
        <PackageReference Include="Microsoft.Build" Version="18.11.0" ExcludeAssets="runtime" PrivateAssets="all" NoWarn="NU1701">
          <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Build.Framework" Version="18.11.0" ExcludeAssets="runtime" PrivateAssets="all" NoWarn="NU1701">
          <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2"/>
        <PackageReference Include="SkiaSharp" Version="4.153.1" />
        <!-- Microsoft.Build.Framework requires this exact version; bump all three together. -->
        <PackageReference Include="Microsoft.NET.StringTools" Version="18.11.0" ExcludeAssets="runtime" PrivateAssets="all">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
        <PackageReference Include="NuGet.Commands" Version="7.9.0"/>
        <!-- NuGet.Packaging floors this at the vulnerable 8.0.1 (NU1902/NU1903); pinned to the patched release. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13"/>
        <PackageReference Include="NuGet.Frameworks" Version="7.9.0" ExcludeAssets="runtime" PrivateAssets="all">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Model import (FBX, and any other format Assimp handles) is editor-side only:
             the runtime consumes glTF 2.0 geometry, so shipped games never link Assimp.
             Pulls in Ultz.Native.Assimp transitively for the native libassimp binaries. -->
        <PackageReference Include="Silk.NET.Assimp" Version="2.23.0"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Packages/registry-mass4.pub" LogicalName="registry-mass4.pub"/>
    </ItemGroup>

    <!-- Where the built-in bricks live when run from a checkout (ProjectPackages.BuiltinDirectory); publishing ships them
         from Turian/Packages/Bricks.targets. -->
    <ItemGroup>
        <AssemblyMetadata Include="TurianBuiltinPackages" Value="$([System.IO.Path]::GetFullPath('$(SolutionDir)/Turian/Packages'))"/>
    </ItemGroup>

    <Import Project="Build/Settings/RuntimeDependencies.targets"/>
</Project>
