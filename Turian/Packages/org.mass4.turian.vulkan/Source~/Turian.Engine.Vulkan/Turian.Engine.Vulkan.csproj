<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Turian.Engine.Core</RootNamespace>
        <PackageId>MASS4.Turian.Engine.Vulkan</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Turian.Tests"/>
        <InternalsVisibleTo Include="Turian.Benchmarks"/>
    </ItemGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Turian/Engine/Core/Turian.Engine.Core.csproj"/>
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <PackageReference Include="Silk.NET.Input" Version="2.23.0"/>
        <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0"/>
        <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0"/>
        <PackageReference Include="Silk.NET.Windowing.Common" Version="2.23.0"/>
        <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.23.0"/>
        <PackageReference Include="StbImageSharp" Version="2.30.16" />
        <PackageReference Include="Silk.NET.Input.Extensions" Version="2.23.0"/>
        <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="**/*.spv"/>
    </ItemGroup>

    <!-- The brick ships this assembly prebuilt in Precast~/lib; games load it from there. -->
    <Target Name="PrecastRuntimeAssemblies" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(SolutionDir)/Turian/Packages/org.mass4.turian.vulkan/Precast~/lib"/>
    </Target>
</Project>
