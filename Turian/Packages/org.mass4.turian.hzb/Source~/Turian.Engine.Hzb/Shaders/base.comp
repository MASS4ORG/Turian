#version 450
layout(local_size_x = 8, local_size_y = 8) in;
#ifdef SINGLE_SAMPLE
layout(set = 0, binding = 0) uniform sampler2D depth;
#else
layout(set = 0, binding = 0) uniform sampler2DMS depth;
#endif
layout(r32f, set = 0, binding = 1) writeonly uniform image2D outputDepth;
layout(push_constant) uniform Push { ivec2 viewport; int samples; int unused; } push;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(outputDepth)))) return;
    float farthest = 1.0;
    if (all(lessThan(pixel, push.viewport))) {
#ifdef SINGLE_SAMPLE
        farthest = texelFetch(depth, pixel, 0).r;
#else
        farthest = 0.0;
        for (int sampleIndex = 0; sampleIndex < push.samples; ++sampleIndex)
            farthest = max(farthest, texelFetch(depth, pixel, sampleIndex).r);
#endif
    }
    imageStore(outputDepth, pixel, vec4(farthest));
}
