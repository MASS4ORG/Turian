#version 450
layout(local_size_x = 64) in;
struct Candidate { vec4 minimum; vec4 maximum; uvec4 command; uvec4 padding; };
layout(std430, set = 0, binding = 0) readonly buffer Candidates { Candidate candidates[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Commands { uint commands[]; };
layout(set = 0, binding = 2) uniform sampler2D pyramid;
layout(std430, set = 0, binding = 3) buffer Counts { uint visible; uint culled; };
layout(push_constant) uniform Push { mat4 viewProjection; uvec2 viewport; uint count; float bias; } push;

bool hidden(Candidate candidate) {
    if (candidate.minimum.w == 0.0) return false;
    vec2 low = vec2(1.0), high = vec2(-1.0);
    float nearest = 1.0;
    for (int corner = 0; corner < 8; ++corner) {
        vec3 position = vec3((corner & 1) == 0 ? candidate.minimum.x : candidate.maximum.x,
                             (corner & 2) == 0 ? candidate.minimum.y : candidate.maximum.y,
                             (corner & 4) == 0 ? candidate.minimum.z : candidate.maximum.z);
        vec4 clip = push.viewProjection * vec4(position, 1.0);
        if (any(isnan(clip)) || any(isinf(clip)) || clip.w <= 0.0 || clip.z <= 0.0) return false;
        vec3 ndc = clip.xyz / clip.w;
        low = min(low, ndc.xy);
        high = max(high, ndc.xy);
        nearest = min(nearest, ndc.z);
    }
    vec2 pixels = vec2(push.viewport);
    low = clamp(floor((low * 0.5 + 0.5) * pixels) - 1.0, vec2(0.0), pixels - 1.0);
    high = clamp(ceil((high * 0.5 + 0.5) * pixels) + 1.0, vec2(0.0), pixels - 1.0);
    vec2 span = max(high - low + 1.0, vec2(1.0));
    int level = min(int(ceil(log2(max(span.x, span.y)))), textureQueryLevels(pyramid) - 1);
    ivec2 first = ivec2(low) >> level, last = ivec2(high) >> level;
    float farthest = max(max(texelFetch(pyramid, first, level).r,
                             texelFetch(pyramid, ivec2(last.x, first.y), level).r),
                         max(texelFetch(pyramid, ivec2(first.x, last.y), level).r,
                             texelFetch(pyramid, last, level).r));
    return nearest > farthest + push.bias;
}
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= push.count) return;
    Candidate candidate = candidates[index];
    bool occluded = hidden(candidate);
    uint offset = index * 5;
    commands[offset] = candidate.command.x;
    commands[offset + 1] = occluded ? 0 : 1;
    commands[offset + 2] = candidate.command.z;
    commands[offset + 3] = candidate.command.w;
    commands[offset + 4] = 0;
    if (occluded) atomicAdd(culled, 1); else atomicAdd(visible, 1);
}
