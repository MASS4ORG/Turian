<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.0.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>MASS4.Turian.Engine.UI</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere/Guinevere.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Styling/Guinevere.Styling.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MASS4.Guinevere" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
        <PackageReference Include="MASS4.Guinevere.Styling" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Turian.Tests"/>
    </ItemGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Turian/Engine/Core/Turian.Engine.Core.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Turian/Packages/org.mass4.turian.vulkan/Source~/Turian.Engine.Vulkan/Turian.Engine.Vulkan.csproj"/>
    </ItemGroup>

    <!-- The brick ships its assembly prebuilt in Precast~/lib; games and the editor load it from there. Third-party
         assemblies come from the brick's nuget map through `brick sync-precast`, never from a hand-kept list. -->
    <Target Name="PrecastRuntimeAssemblies" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(SolutionDir)/Turian/Packages/org.mass4.turian.ui/Precast~/lib"/>
    </Target>

</Project>
