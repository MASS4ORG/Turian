<Project>
  <ItemGroup>
    <_TurianAndroidNative Include="$(MSBuildThisFileDirectory)arm64-v8a/*.so">
      <Abi>arm64-v8a</Abi>
    </_TurianAndroidNative>
    <_TurianAndroidNative Include="$(MSBuildThisFileDirectory)x86_64/*.so">
      <Abi>x86_64</Abi>
    </_TurianAndroidNative>
    <AndroidNativeLibrary Include="@(_TurianAndroidNative)" />
  </ItemGroup>
  <Target Name="TurianReplaceAndroidNativeLibraries" BeforeTargets="_BuildApkEmbed;_BuildApkFastDev">
    <Error Condition="'@(_TurianAndroidNative->Count())' != '4'"
           Text="Rebuild the Android SDL prebuilts with tools/android-native.cs before exporting." />
    <ItemGroup>
      <_AdditionalNativeLibraryReferences Remove="@(_AdditionalNativeLibraryReferences)"
          Condition="'%(_AdditionalNativeLibraryReferences.Filename)' == 'libSDL2' or '%(_AdditionalNativeLibraryReferences.Filename)' == 'libmain'" />
      <AndroidNativeLibrary Remove="@(AndroidNativeLibrary)"
          Condition="'%(AndroidNativeLibrary.Filename)' == 'libSDL2' or '%(AndroidNativeLibrary.Filename)' == 'libmain'" />
      <_NativeLibraries Remove="@(_NativeLibraries)"
          Condition="'%(_NativeLibraries.Filename)' == 'libSDL2' or '%(_NativeLibraries.Filename)' == 'libmain'" />
      <AndroidNativeLibrary Include="@(_TurianAndroidNative)" />
      <_NativeLibraries Include="@(_TurianAndroidNative)" />
    </ItemGroup>
  </Target>
</Project>
