<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)/Turian/Editor/Core/Turian.Editor.Core.csproj" />
    <ProjectReference Include="../Turian.Android.Dependencies/Turian.Android.Dependencies.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build" Version="18.11.0" ExcludeAssets="runtime" PrivateAssets="all" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.11.0" ExcludeAssets="runtime" PrivateAssets="all" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.11.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <AssemblyMetadata Include="TurianAndroidSdk" Value="$(NETCoreSdkVersion)" />
    <InternalsVisibleTo Include="Turian.Tests" />
    <Content Include="../../Launcher~/*" Link="AndroidLauncher/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="EmbedAndroidDependencies" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../Turian.Android.Dependencies/Turian.Android.Dependencies.csproj" Targets="GetTurianRuntimeDependencies" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_AndroidManifestLine" />
    </MSBuild>
    <WriteLinesToFile File="$(IntermediateOutputPath)Android.RuntimeDependencies.txt" Lines="@(_AndroidManifestLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)Android.RuntimeDependencies.txt" LogicalName="Turian.Android.RuntimeDependencies" />
    </ItemGroup>
  </Target>
  <Target Name="PrecastAndroidPlatform" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="../../Precast~/editor" />
  </Target>
</Project>
