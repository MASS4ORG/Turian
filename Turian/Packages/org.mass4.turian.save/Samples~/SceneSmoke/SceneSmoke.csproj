<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(TurianDir)/Turian/Engine/Core/Turian.Engine.Core.csproj" />
        <ProjectReference Include="$(TurianDir)/Turian/Packages/org.mass4.turian.ui/Source~/Turian.Engine.UI/Turian.Engine.UI.csproj" />
        <ProjectReference Include="$(TurianDir)/Turian/Packages/org.mass4.turian.save/Source~/Turian.Engine.Save/Turian.Engine.Save.csproj" />
        <ProjectReference Include="$(TurianDir)/Turian/Editor/CSharp/CodeGenerator/Turian.CSharp.CodeGenerator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <Compile Include="../Assets/**/*.cs" />
        <None Include="../Assets/save.prefab" Link="save.prefab" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../Assets/SaveShowcase.cs.meta" Link="SaveShowcase.cs.meta"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Target Name="RequireEngineCheckout" BeforeTargets="PrepareForBuild" Condition="'$(TurianDir)' == ''">
        <Error Text="Pass -p:TurianDir=/path/to/Turian to use the engine checkout." />
    </Target>
</Project>
