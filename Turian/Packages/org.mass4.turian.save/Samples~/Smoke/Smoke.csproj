<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(TurianDir)/Turian/Packages/org.mass4.turian.save/Source~/Turian.Engine.Save/Turian.Engine.Save.csproj" />
    </ItemGroup>
    <Target Name="RequireEngineCheckout" BeforeTargets="PrepareForBuild" Condition="'$(TurianDir)' == ''">
        <Error Text="Pass -p:TurianDir=/path/to/Turian to use the save brick checkout." />
    </Target>
</Project>
