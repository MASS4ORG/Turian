<Project>
    <!-- Internal paths -->
    <PropertyGroup>
        <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
        <UseFileScopedNamespaces>true</UseFileScopedNamespaces>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <Mass4EnforcedDiagnostics>IDE0011;IDE0001;IDE0002;IDE0004;IDE0005;IDE0018;IDE0044;IDE0062;IDE0250;IDE0251;IDE0320;IDE0370;IDE0380;CA1707;IDE1006</Mass4EnforcedDiagnostics>
        <WarningsAsErrors Condition="'$(CI)' == 'true'">$(WarningsAsErrors);$(Mass4EnforcedDiagnostics)</WarningsAsErrors>
        <AnalysisLevel>10.0</AnalysisLevel>
    </PropertyGroup>

    <!-- `Directory.Build.local.props` points to local project -->
    <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
            Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')"/>

    <!-- `-p:NoLocalPackages=true` ignores every local checkout and builds against the published packages -->
    <PropertyGroup Condition="'$(NoLocalPackages)' == 'true'">
        <GuinevereLocalPath></GuinevereLocalPath>
        <Ktx2LocalPath></Ktx2LocalPath>
        <OapLocalPath></OapLocalPath>
    </PropertyGroup>

    <!-- Checked by Directory.Build.targets before a pack or publish; list each local checkout here -->
    <PropertyGroup>
        <UsesLocalPackages Condition="'$(GuinevereLocalPath)' != '' Or '$(Ktx2LocalPath)' != '' Or '$(OapLocalPath)' != ''">true</UsesLocalPackages>
    </PropertyGroup>

    <!-- External libraries included in every project -->
    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="JetBrains.Annotations"/>
    </ItemGroup>
</Project>
