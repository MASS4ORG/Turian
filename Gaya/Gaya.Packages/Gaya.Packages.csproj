<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Gaya.Packages</RootNamespace>
        <AssemblyName>Gaya.Packages</AssemblyName>
        <PackageId>MASS4.Gaya.Packages</PackageId>
        <Title>Gaya Packages</Title>
        <Description>Package manifests, resolution, lock files and the machine-wide package store shared by Gaya hosts. No UI; shared presentation metadata comes from MASS4.Attributes.</Description>
    </PropertyGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' != ''">
        <ProjectReference Include="$(GuinevereLocalPath)/Attributes/Attributes.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' == ''">
        <PackageReference Include="MASS4.Attributes" Version="6.*" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="MASS4.Attributes" />
    </ItemGroup>
</Project>
