<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Gaya.Packages</RootNamespace>
        <AssemblyName>Gaya.Packages</AssemblyName>
        <PackageId>MASS4.Gaya.Packages</PackageId>
        <Title>Gaya Packages</Title>
        <Description>Package manifests, resolution, lock files and the machine-wide package store shared by Gaya hosts. No UI and no dependencies beyond .NET.</Description>
    </PropertyGroup>

</Project>
