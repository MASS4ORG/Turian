<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Gaya.Packages.Editor</RootNamespace>
        <AssemblyName>Gaya.Packages.Editor</AssemblyName>
        <PackageId>MASS4.Gaya.Packages.Editor</PackageId>
        <Title>Gaya Packages Editor</Title>
        <Description>The Bricks panel and its controller: browse, install, enable and remove bricks of the studio or of an open workspace, through host-neutral workspace and service contracts.</Description>
    </PropertyGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Sdk/Gaya.Sdk.csproj"/>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Packages/Gaya.Packages.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' != ''">
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Excalibur/Guinevere.Excalibur.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' == ''">
        <PackageReference Include="MASS4.Guinevere.Excalibur" Version="6.*"/>
    </ItemGroup>

</Project>
