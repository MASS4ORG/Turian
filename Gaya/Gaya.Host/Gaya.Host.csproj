<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Gaya.Host</RootNamespace>
        <AssemblyName>Gaya.Host</AssemblyName>
        <PackageId>MASS4.Gaya.Host</PackageId>
        <Title>Gaya Host</Title>
        <Description>The Gaya workbench host: plugin discovery and activation, the docking workbench, command palette, menus and layout persistence. Referenced by the application shell, not by plugins.</Description>
    </PropertyGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Sdk/Gaya.Sdk.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' != ''">
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Excalibur/Guinevere.Excalibur.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(GuinevereLocalPath)' == ''">
        <PackageReference Include="MASS4.Guinevere.Excalibur" Version="5.*"/>
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12"/>
    </ItemGroup>

</Project>
