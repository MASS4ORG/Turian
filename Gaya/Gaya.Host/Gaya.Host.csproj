<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>3.8.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Gaya.Host</RootNamespace>
        <AssemblyName>Gaya.Host</AssemblyName>
        <Title>Gaya Host</Title>
        <Description>The Gaya workbench host: plugin discovery and activation, the docking workbench, command palette, settings panel, menus and layout persistence. Referenced by the application shell, not by plugins.</Description>
    </PropertyGroup>

    <!-- Internal libraries -->
    <ItemGroup>
        <EmbeddedResource Include="Resources/logo.png"/>
        <EmbeddedResource Include="Themes/*.pss" LogicalName="Gaya.Host.Themes.%(Filename)%(Extension)"/>
        <EmbeddedResource Include="Icons/**/*.svg;Icons/**/LICENSE" LogicalName="Gaya.Host.Icons/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Sdk/Gaya.Sdk.csproj" />
        <ProjectReference Include="$(SolutionDir)/Gaya/MASS4.Bricks/MASS4.Bricks.csproj" />
        <ProjectReference Include="$(SolutionDir)/Gaya/Gaya.Packages.Editor/Gaya.Packages.Editor.csproj" />
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Excalibur/Guinevere.Excalibur.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
        <ProjectReference Include="$(GuinevereLocalPath)/Autoformers.Excalibur/Autoformers.Excalibur.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Styling/Guinevere.Styling.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
        <ProjectReference Include="$(GuinevereLocalPath)/Guinevere.Svg/Guinevere.Svg.csproj" Condition="'$(GuinevereLocalPath)' != ''" />
    </ItemGroup>

    <!-- External libraries -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
        <PackageReference Include="MASS4.Guinevere.Excalibur" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
        <PackageReference Include="MASS4.Autoformers.Excalibur" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
        <PackageReference Include="MASS4.Guinevere.Styling" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
        <PackageReference Include="MASS4.Guinevere.Svg" Version="6.*" Condition="'$(GuinevereLocalPath)' == ''" />
    </ItemGroup>

</Project>
